 LTEXT "Transparency",-1,298,233,80,12
 CONTROL "",IDC_RING_OPACITY,"msctls_trackbar32",WS_TABSTOP | TBS_NOTICKS,382,226,106,25
 LTEXT "20%",IDC_RING_OPACITY_LABEL,493,233,45,12
 LTEXT "Capture target",-1,298,266,80,12
 COMBOBOX IDC_CAPTURE,382,260,156,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
