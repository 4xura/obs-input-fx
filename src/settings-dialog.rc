#include <windows.h>
#include "resource.h"
IDR_OVERLAY RCDATA "../data/overlay.html"
IDD_SETTINGS DIALOGEX 0,0,560,360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "InputFX"
FONT 9,"Segoe UI"
BEGIN
